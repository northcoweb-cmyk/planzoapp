# ─── KOVR Sports — environment configuration ────────────────────────────────
# Copy to .env.local and fill in. NEVER commit a filled-in file.
#
#   cp .env.example .env.local
#
# The application reads these server-side only. No key is ever sent to,
# embedded in, or reachable from the browser bundle.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# The Odds API key — https://the-odds-api.com  (free tier available)
# Without this, KOVR runs but every sports surface reports
# "Live sports data temporarily unavailable" rather than inventing data.
KOVR_ODDS_API_KEY=

# ── SERVER ──────────────────────────────────────────────────────────────────
KOVR_PORT=4300
KOVR_HOST=127.0.0.1

# Where the SQLite database file lives (relative paths resolve to kovr/).
KOVR_DB_PATH=data/kovr.db

# ── DATA PROVIDER TUNING ────────────────────────────────────────────────────
# Bookmaker regions to request: us, us2, uk, eu, au (comma separated)
KOVR_ODDS_REGIONS=us
# Preferred bookmaker key. When present in a response its price wins; the
# first available bookmaker is used otherwise. Never fabricated.
KOVR_ODDS_PREFERRED_BOOKMAKER=
# Hard ceiling on provider requests per hour. KOVR refuses to exceed it.
KOVR_ODDS_HOURLY_BUDGET=180

# ── DEMO / DEVELOPER ────────────────────────────────────────────────────────
# Simulated starting balance, in whole dollars. Demo money only.
KOVR_DEMO_STARTING_BALANCE=10000
# Set to 1 to expose /admin and the developer API. Never enable in public.
KOVR_ADMIN_ENABLED=0
