{
  "framework": null,
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/p/:code*", "destination": "/index.html" },
    { "source": "/e/:id*", "destination": "/index.html" }
  ]
}
