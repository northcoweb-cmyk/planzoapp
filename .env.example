# ─── PLANZO ENVIRONMENT ────────────────────────────────────────────────
# Copy to .env (local) or paste into Render env vars (production).
# NOTHING in this file is browser-safe unless marked PUBLIC.

# ── REQUIRED NOW ──────────────────────────────────────────────────────
PORT=4000
PLANZO_PUBLIC_URL=http://localhost:4000
# Signs participant sessions + ticket tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PLANZO_SECRET=

# Persistence. Any Upstash account works — every key is namespaced
# planzo:* regardless. SERVER-ONLY.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PLANZO_REDIS_PREFIX=planzo:
# Leave blank to fall back to ./data/*.json (fine for local dev).

# ── AI (OPTIONAL — app is fully functional without it) ────────────────
# SERVER-ONLY. Without a key the deterministic engine handles everything
# and AI spend is exactly $0. Provider is chosen by whichever key is set.
#
# Measured: gpt-4.1-nano extracts intent as well as anything larger, at
# ~$0.000023 per call. $5 of credit is ~217,000 calls.
OPENAI_API_KEY=
PLANZO_AI_PROVIDER=openai
PLANZO_AI_MODEL_CHEAP=gpt-4.1-nano
PLANZO_AI_MODEL_SMART=gpt-4o-mini
# Alternative provider:
# ANTHROPIC_API_KEY=
# PLANZO_AI_MODEL_CHEAP=claude-haiku-4-5-20251001

# HARD SPEND CEILINGS (USD). Hit them and AI returns "unavailable";
# the app keeps working on the rules engine. This is the kill switch.
PLANZO_AI_DAILY_USD=1.00
PLANZO_AI_MONTHLY_USD=20.00
# Per-plan ceiling stops one abusive plan burning the day's budget.
PLANZO_AI_PER_PLAN_USD=0.05

# ── LIVE DATA ─────────────────────────────────────────────────────────
# Weather: Open-Meteo. FREE, no key, no account. Already wired.
PLANZO_WEATHER_ENABLED=true

# Places: Google Maps Platform. SERVER-ONLY key, restricted to Places API.
# Leave blank and place search reports "unavailable" rather than faking it.
GOOGLE_MAPS_API_KEY=
PLANZO_PLACES_DAILY_USD=2.00

# Events: Ticketmaster Discovery. FREE — 5,000 requests/day, no billing
# account, no card. Get a consumer key at developer.ticketmaster.com.
EVENT_PROVIDER=ticketmaster
TICKETMASTER_API_KEY=

# ── AUTH + CLOUD DATA: Supabase (free tier, 50k monthly users) ────────
# Gives Google OAuth + email/password and a Postgres that follows the user
# across devices. ANON key is browser-safe by design; SERVICE_ROLE is not.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── REQUIRED LATER (do not sign up yet) ───────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=   # PUBLIC — browser-safe
# BREVO_API_KEY=
