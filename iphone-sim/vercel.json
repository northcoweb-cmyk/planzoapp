{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/_sim/root",
      "destination": "/api/proxy?__p=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/proxy?__p=/:path*"
    }
  ]
}
